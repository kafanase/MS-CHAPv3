[Unit]
Description=MS-CHAPv3 proxy server
After=network-online.target
Wants=network-online.target

[Service]
User=mschapv3
Group=mschapv3
WorkingDirectory=/etc/mschapv3
ExecStart=/usr/local/bin/mschapv3-server -c /etc/mschapv3/config.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/mschapv3

[Install]
WantedBy=multi-user.target
